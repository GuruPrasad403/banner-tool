{
  "name": "xyz-html-banner-validator",
  "version": "1.0.0",
  "type": "module",
  "description": "XYZ HTML Banner Validator and Automated Screenshot Generator with Nested ISI Scroll Support",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently \"node src/server.js\" \"vite\"",
    "server": "node src/server.js",
    "client": "vite",
    "build": "vite build",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node src/cli.js validate",
    "capture": "node src/cli.js capture"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^23.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.446.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
